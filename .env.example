# Copy to .env (or load from your own secrets file). Never commit real values.
DISCORD_TOKEN=
IBMI_HOST=
IBMI_USER=
IBMI_PASS=

# Optional
# Encrypt the IBM i connection with SSL. The IBM i certificate must be trusted by Java.
IBMI_SECURE=false
# Register the command in one server only (shows up instantly).
DISCORD_GUILD_ID=
# Replies are private to the person who ran the command. Set to true to post them in the channel.
REPLY_PUBLIC=false
